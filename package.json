{
  "name": "prototype-review-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "原型评审台的独立静态官网",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "typecheck": "react-router typegen && tsc --noEmit",
    "build": "react-router build && node scripts/prepare-pages.mjs",
    "preview": "node scripts/serve-pages.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "radix-ui": "1.8.1",
    "lucide-react": "1.61.0",
    "cn": "0.5.0",
    "class-variance-authority": "0.7.1",
    "isbot": "5.2.2"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.0",
    "@react-router/node": "8.5.0",
    "vite": "8.3.5",
    "typescript": "6.0.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "shadcn": "4.22.1",
    "tw-animate-css": "1.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2"
  }
}
